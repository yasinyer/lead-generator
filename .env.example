# Kopieer naar .env en vul in.

# Google Cloud API-key met "Places API (New)" en "PageSpeed Insights API" ingeschakeld.
# Zonder key werkt de tool ook, maar dan enkel met OpenStreetMap (geen reviews/ratings).
GOOGLE_API_KEY=

# Optioneel: aparte key voor PageSpeed (standaard dezelfde als hierboven).
PAGESPEED_API_KEY=

# Maximaal aantal Google Places-calls per scan (bescherming tegen kosten).
PLACES_MAX_CALLS=150

# Jouw gegevens voor de pitch-teksten in het dashboard.
DESIGNER_NAME=
DESIGNER_CITY=Hasselt
DESIGNER_PHONE=
DESIGNER_EMAIL=
DESIGNER_WEBSITE=
PRICE_ONEPAGER=1.200

# Optioneel: pad naar een eigen Chrome/Chromium als 'playwright install chromium' niet lukt.
CHROMIUM_PATH=
